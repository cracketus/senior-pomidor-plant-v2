# Device
DEVICE_ID=balcony-edge-01
POLL_INTERVAL_SECONDS=60
MOCK_SENSORS=true
POD1_ENABLED=true
POD2_ENABLED=true

# Primary MQTT transport
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=senior-pomidor
MQTT_TLS=false

# Required application-acknowledged telemetry transport
HTTP_ENABLED=true
CORE_HTTP_URL=http://192.0.2.10:8000/api/v1/edge/telemetry
HTTP_TIMEOUT_SECONDS=5
TELEMETRY_UPLOAD_TOKEN=

# Durable SQLite telemetry spool (the data directory is persisted by Docker)
TELEMETRY_SPOOL_DB_PATH=data/telemetry-spool.sqlite3
TELEMETRY_SPOOL_PENDING_RETENTION_DAYS=30
TELEMETRY_SPOOL_DELIVERED_RETENTION_DAYS=7
TELEMETRY_SPOOL_MAX_PAYLOAD_BYTES=16384
TELEMETRY_SPOOL_CAPACITY_MB=1536
TELEMETRY_SPOOL_BATCH_SIZE=10
TELEMETRY_SPOOL_RATE_LIMIT_PER_SECOND=2
TELEMETRY_SPOOL_BUSY_TIMEOUT_MS=5000
TELEMETRY_SPOOL_CHECKPOINT_INTERVAL_SECONDS=300
TELEMETRY_SPOOL_RETRY_SCHEDULE_SECONDS=5,15,30,60,300
TELEMETRY_SPOOL_RETRY_JITTER=0.2
TELEMETRY_SPOOL_MAX_ATTEMPTS=
TELEMETRY_SPOOL_DISK_WARNING_PERCENT=80
TELEMETRY_SPOOL_DISK_DEGRADED_PERCENT=90
TELEMETRY_SPOOL_DISK_CRITICAL_PERCENT=95

# Legacy JSON telemetry queue, imported once into SQLite at startup.
LOCAL_STORAGE_DIR=data/telemetry
LOCAL_EVENT_DIR=data/events
LOCAL_STORAGE_MAX_AGE_DAYS=30
LOCAL_STORAGE_MAX_SIZE_MB=256

# Raspberry Pi camera photos
CAMERA_ENABLED=false
CAMERA_INTERVAL_SECONDS=3600
CAMERA_STORAGE_DIR=data/photos
CAMERA_DEVICE=/dev/video0
CAMERA_RESOLUTION=1920x1080
CAMERA_JPEG_QUALITY=95
CAMERA_PROCESS_TIMEOUT_SECONDS=20
CAMERA_SKIP_FRAMES=5
CAMERA_MAX_ATTEMPTS=3
CAMERA_MIN_SHARPNESS=6.0

# Optional photo upload to the Core server.
# Photos are uploaded as multipart/form-data; MQTT is used for telemetry only.
PHOTO_UPLOAD_ENABLED=false
PHOTO_UPLOAD_URL=http://192.0.2.10:8000/api/v1/edge/photos
PHOTO_UPLOAD_TOKEN=

# I2C addresses
ADS1115_ADDRESS=0x48
BME280_ADDRESS=0x76
BH1750_ADDRESS=0x23
MLX90615_ADDRESS=0x5A
INA219_ADDRESS=0x40

# Health control sensors and Raspberry Pi OS probes
WIFI_INTERFACE=wlan0
WIFI_PROFILE_DIR=/etc/NetworkManager/system-connections
WIFI_PREFERRED_PROFILE=
NETWORK_CHECK_HOST=1.1.1.1
NETWORK_DNS_CHECK_HOST=example.com
NETWORK_RECOVERY_STATUS_FILE=data/network-recovery/status.json
DISK_USAGE_PATH=/
SERVICE_NAME=senior-pomidor-edge

# ADS1115 soil moisture channels and calibration.
# These are raw ADS1115 readings from AnalogIn.value, not volts.
ADS1115_POD1_CHANNEL=A0
ADS1115_POD2_CHANNEL=A1
ADS1115_POD1_DRY_READING=17736
ADS1115_POD1_WET_READING=7220
ADS1115_POD2_DRY_READING=17776
ADS1115_POD2_WET_READING=7220

# DS18B20 1-Wire ROM IDs
DS18B20_POD1_ROM=28-000000000001
DS18B20_POD2_ROM=28-000000000002

# Development only. Omit or set empty in production.
MAX_TICKS=

# Layered edge watchdog. Host actions require setup_raspberry_pi.sh --install-watchdog.
WATCHDOG_HEARTBEAT_FILE=data/watchdog/heartbeat.json
WATCHDOG_STATUS_FILE=data/watchdog/status.json
WATCHDOG_HISTORY_FILE=data/watchdog/history.json
WATCHDOG_MAINTENANCE_FILE=data/watchdog/maintenance.json
WATCHDOG_POLL_SECONDS=15
# Omit these to use max(180, 3 * POLL_INTERVAL_SECONDS).
# Must be greater than POLL_INTERVAL_SECONDS.
# WATCHDOG_TIMEOUT_SECONDS=180
# WATCHDOG_STARTUP_GRACE_SECONDS=180
WATCHDOG_RESTART_LIMIT=3
WATCHDOG_RESTART_WINDOW_SECONDS=1800
WATCHDOG_COOLDOWN_SECONDS=300
WATCHDOG_REBOOT_LIMIT=1
WATCHDOG_REBOOT_WINDOW_SECONDS=3600
# Controlled reboot is deliberately disabled by default.
WATCHDOG_ALLOW_REBOOT=false
