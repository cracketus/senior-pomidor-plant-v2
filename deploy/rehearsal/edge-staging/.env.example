# Copy to .env, replace every placeholder, and run: chmod 0600 .env
# EDGE_IMAGE is managed by manage.sh and must not be set here.

STAGING_MQTT_HOST=mqtt.staging.example.invalid
STAGING_MQTT_PORT=8883
STAGING_MQTT_USERNAME=replace-with-staging-only-user
STAGING_MQTT_PASSWORD=replace-with-staging-only-password
STAGING_MQTT_TLS=true

STAGING_CORE_HTTP_URL=https://core.staging.example.invalid/api/v1/edge/telemetry
STAGING_TELEMETRY_UPLOAD_TOKEN=replace-with-staging-only-token
